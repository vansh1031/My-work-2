# Only needed for server mode (a shared Factory Atlas server, see SETUP.md Part C).
# Browser mode, the default, needs no settings at all.
# Copy this file to .env and change the values. Never commit the real .env file.

# Connection to the PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/factory_atlas

# Password of the "admin" user on a brand new database. Must be changed at first sign-in.
INITIAL_ADMIN_PASSWORD=change-me-now

# "true" adds 6 sample factories on an empty database. Use "false" for a real client.
SEED_SAMPLE_DATA=true

# Port of the server.
PORT=4000

# Which addresses may call the server. "*" allows any (fine on a private network).
CORS_ORIGINS=*

# How much the server writes to its log: error, warn, info or debug.
LOG_LEVEL=info
