{
  "dataMode": "browser",
  "apiBaseUrl": "http://localhost:4000",
  "allowServerAddressChange": true,
  "debug": false,
  "sessionIdleMinutes": 30,
  "defaultShiftsPerDay": 2,
  "showSearchWhenMoreThan": 5,
  "statusLabels": {
    "running": "Running",
    "stopped": "Stopped",
    "aborted": "Aborted",
    "shift_ended": "Shift ended",
    "unknown": "No data"
  },
  "map": {
    "useOnlineTiles": true,
    "tileStyleUrl": "https://tiles.openfreemap.org/styles/positron"
  },
  "features": {
    "globe": true,
    "factoryFloor3d": true,
    "excelUpload": true,
    "manualStatusEdit": true,
    "history": true
  },
  "legal": {
    "privacyPolicy": "legal/privacy.md",
    "terms": "legal/terms.md"
  }
}
